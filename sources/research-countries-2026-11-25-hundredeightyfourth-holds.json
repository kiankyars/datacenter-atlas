  "holds": [
    {
      "candidate": "Lumilogic Riihimäki",
      "disposition": "hold_observation",
      "source_url": "https://lumilogic.fi/",
      "reason": "The developer dates its Junttatie 2 construction update to June 2026. No recent dated project status was established."
    },
    {
      "candidate": "NovaGen Voikkaa campus, Kouvola",
      "disposition": "hold_scope",
      "source_url": "https://www.kouvola.fi/ajankohtaiset/pohina-paalla/",
      "reason": "Kouvola confirms a campus proposal on the former paper mill estate. A June permit covers conversion of a building for Redeve. The reviewed sources do not establish which portion of the estate belongs to NovaGen’s proposed campus."
    },
    {
      "candidate": "Datasur, Suriname",
      "reason": "The operator advertised a September 18 tour and the Surinamese exchange identifies Datasur as its host in Paramaribo. The tour and the exchange observation could not be attributed to one of the two documented addresses."
    },
    {
      "candidate": "BR.Digital São Paulo",
      "reason": "The exchange directory gives Rua Cenno Sbrighi 27. The operator registration gives number 45. The relationship between the two properties needs confirmation."
    },
    {
      "candidate": "Wowrack and Sabey, Tukwila",
      "reason": "Wowrack identifies its Tukwila operation inside Intergate West, a retained campus. The SIX report labels its other Sabey location without identifying whether its observation belongs specifically to the proposed Intergate East building."
    },
    {
      "candidate": "Sparc Systems Lilongwe",
      "disposition": "hold_status",
      "source_url": "https://malawi24.com/2026/11/06/young-malawian-innovators-catch-us-embassy-attention/",
      "reason": "The operator announced its Lilongwe colocation launch in April. Two November reports describe a tour of the data centre on November 5. The quoted participants discuss the startup programme, and neither report attributes its account of the facility tour to an eyewitness. A dated participant account of the facility itself remains outstanding."
    }
  ],
