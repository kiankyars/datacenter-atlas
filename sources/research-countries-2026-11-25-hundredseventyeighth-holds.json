  "holds": [
    {
      "candidate": "NAP Caribe, Dominican Republic",
      "reason": "The October operator tour report does not identify which of its two Santo Domingo premises hosted the visit. The historical colocation award and provider listing do not by themselves date current activity at a single facility."
    },
    {
      "candidate": "KIO Guatemala GTM1 and GTM2",
      "reason": "KIO identifies the existing and proposed Mixco sites. The relevant regional construction announcement is from September 2025, outside the admission window; later copies of that coverage are not new observations."
    },
    {
      "candidate": "Cirion/Datrix BOG2, Bogotá",
      "reason": "The association records a completed October tour in Bogotá. The event page omits the facility code; BOG1 also appears in historical third-party material. The visit alone does not establish which Cirion premises were observed."
    },
    {
      "candidate": "Switch Datacenters Lanaken",
      "disposition": "hold_locator",
      "source_url": "https://switchdatacenters.com/news/possible-development-of-a-data-center-in-lanaken/",
      "reason": "The proposed project occupies only part of the former Sappi mill. The mill’s shared civic address does not identify the proposed data centre parcel."
    },
    {
      "candidate": "Switch Datacenters De Kwakel, Mijnsherenweg",
      "disposition": "hold_status",
      "source_url": "https://data.rechtspraak.nl/uitspraken/content?id=ECLI:NL:RVS:2026:4589",
      "reason": "The August court ruling concerns a narrower redevelopment. The material reviewed does not establish a recent decision covering the wider data centre proposal."
    }
  ],
