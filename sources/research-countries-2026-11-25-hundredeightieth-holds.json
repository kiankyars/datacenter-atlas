    {
      "candidate": "CyrusOne Southall, former Honey Monster factory",
      "disposition": "hold_status",
      "source_url": "https://planningdata.london.gov.uk/api-guest/applications/_source/Ealing-253874FUL",
      "reason": "The Greater London Authority feed gives a September decision date alongside an undecided status. A final permission and an appropriate locator remain to be verified."
    },
    {
      "candidate": "H5 Buffalo II, Lockport",
      "reason": "The September facility register named BUF2, but its current release has removed Buffalo. H5 lists two data centers at the same Lockport address. The dated provider record was not carried forward without newer premises-specific evidence."
    },
    {
      "candidate": "Cologix COL3 in Columbus",
      "reason": "The operator names 585 Scherers Court. Two federal points for number 585 differ, and one lands in the independently mapped COL2 building. Confirm COL3’s building before adding a dedicated record."
    },
    {
      "candidate": "Other Winnipeg Internet Exchange locations",
      "reason": "The October 26 exchange site relaunch describes the member facilities guide but does not report a dated physical service observation at the individual 355 Portage, 360 Portage or 167 Lombard facilities."
    },
    {
      "candidate": "EdgeConneX regional buildings",
      "reason": "The current March 2026 regional specifications confirm market-level services and facility area. Their city-level descriptions alone do not identify an independently reusable property location."
    }
  ],
