/*

# Repository policy: default deny. Only authored control-plane files and small
# cryptographic/provenance manifests are versioned. Evidence payloads, imagery,
# caches, databases, licensed inputs, and generated datasets stay excluded.
!/.gitignore
!/.gitleaksignore
!/.gitleaks.toml
!/README.md
!/pyproject.toml
!/uv.lock
!/__init__.py
!/__main__.py
!/*.py

!/.githooks/
/.githooks/*
!/.githooks/pre-commit

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/clean-clone.yml

!/local_data/
/local_data/*
!/local_data/README.md

# Local capture directories and their inventories stay outside Git.

!/datacenter_atlas/
/datacenter_atlas/**/*
!/datacenter_atlas/**/
!/datacenter_atlas/**/*.py
!/datacenter_atlas/**/*.sql

!/scripts/
