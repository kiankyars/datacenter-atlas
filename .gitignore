/*

# Repository policy: default deny. Only authored control-plane files and small
# cryptographic/provenance manifests are versioned. Evidence payloads, imagery,
# caches, databases, licensed inputs, and generated datasets stay excluded.
!/.gitignore
!/.gitleaksignore
!/README.md
!/pyproject.toml
!/uv.lock
!/__init__.py
!/__main__.py
!/*.py

!/.githooks/
/.githooks/*
!/.githooks/pre-commit

!/recovery/
/recovery/*
!/recovery/README.md
!/recovery/kopia-repository-password.age
!/recovery/kopia-repository-v1.SHA256SUMS
/recovery/kopia-repository-v1/

# The exported critical-capture package is portable local evidence. Version its
# small provenance/checksum envelope, but never add the raw capture payload.
!/recovery/external-captures/
/recovery/external-captures/*
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/
/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/*
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/README.md
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/MANIFEST.json
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/MANIFEST.tsv
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/VERIFICATION.tsv
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/SHA256SUMS
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/SYMLINKS.tsv
!/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/METADATA-SHA256SUMS
/recovery/external-captures/atlas-critical-v1-external-captures-2026-08-04/payload/

!/datacenter_atlas/
/datacenter_atlas/**/*
!/datacenter_atlas/**/
!/datacenter_atlas/**/*.py
!/datacenter_atlas/**/*.sql

!/scripts/
/scripts/**/*
!/scripts/**/
!/scripts/**/*.py

!/tests/
/tests/**/*
!/tests/**/
!/tests/**/*.py
!/tests/**/*.json
!/tests/**/*.geojson
!/tests/**/*.csv
!/tests/**/*.osm
!/tests/**/*.html

!/docs/
/docs/**/*
!/docs/**/
!/docs/**/*.md

!/web/
/web/**/*
!/web/**/
!/web/**/*.py
!/web/**/*.html
!/web/**/*.geojson

!/definitions/
/definitions/**/*
!/definitions/**/
!/definitions/**/*.json

!/sources/
/sources/*
!/sources/*.json
/sources/.*/

!/releases/
/releases/*
!/releases/*/
/releases/*/*
!/releases/*/manifest.json
!/releases/*/manifest.sha256
/releases/.*/

!/federated_indexes/
/federated_indexes/*
!/federated_indexes/*/
/federated_indexes/*/*
!/federated_indexes/*/manifest.json
!/federated_indexes/*/manifest.sha256
/federated_indexes/.*/

