    },
    "projects.csv:role_claims_json": {
      "item_type": "role_claim"
    },
    "projects.csv:workloads_json": {
      "item_type": "workload_observation"
    }
  },
  "embedded_types": {
    "imported_project_record": {
      "record_policy": "The record object equals the source snapshot object, including every field, unknown value, qualifier, source and original date precision.",
      "required_fields": [
        "source_dataset",
        "source_record_id",
        "source_file",
        "source_sha256",
        "source_record_sha256",
        "source_repository_commit",
        "identity_decision",
        "source_evidence_ids",
        "record"
      ]
    },
    "role_claim": {
      "allowed_relationship_scopes": [
        "current",
        "intended",
        "unknown"
      ],
      "allowed_roles": [
        "builder",
        "customer",
        "developer",
        "government",
        "hardware_supplier",
        "investor",
        "operator",
        "owner",
        "power_supplier",
        "tenant",
        "user",
        "utility"
      ],
      "optional_fields": [
        "notes",
        "source_record_id"
      ],
      "required_fields": [
        "evidence_id",
        "party",
        "relationship_scope",
        "role"
      ]
    },
    "typed_metric_observation": {
      "allowed_methods": [
        "calculated",
        "equipment_inference",
        "imagery_inference",
        "modeled",
        "permit_inference",
        "reported",
        "unknown"
      ],
      "allowed_stages": [
        "contracted",
        "design",
        "energized",
        "forecast",
        "installed",
        "measured",
        "operational",
        "planned",
        "requested",
        "unknown"
      ],
      "confidence_constraint": "0 <= confidence <= 1",
      "interval_constraint": "0 <= low <= base <= high",
      "required_fields": [
        "as_of_date",
        "base",
        "confidence",
        "evidence_id",
        "high",
        "low",
        "method",
        "metric",
        "notes",
        "stage",
        "target_date",
        "unit"
      ],
      "target_date_allows_null": true,
      "unit_by_metric": {
        "annual_energy_mwh": "MWh/year",
        "critical_it_mw": "MW",
        "generation_nameplate_mw": "MW",
        "grid_connection_mw": "MW",
        "gross_facility_mw": "MW",
        "pue": "ratio"
      }
    },
    "workload_observation": {
      "allowed_deployment_scopes": [
        "intended",
        "operational",
        "unknown"
      ],
      "confidence_constraint": "0 <= confidence <= 1",
      "required_fields": [
        "as_of_date",
        "confidence",
        "deployment_scope",
        "evidence_id",
        "method",
        "workload"
      ]
    }
  },
